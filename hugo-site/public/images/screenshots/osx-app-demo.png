<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <defs>
    <style>
      .bg { fill: #f5f5f5; }
      .window { fill: #ffffff; stroke: #d0d0d0; }
      .titlebar { fill: #e8e8e8; }
      .button { fill: #ff5f57; }
      .button2 { fill: #ffbd2e; }
      .button3 { fill: #28ca42; }
      .text { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; fill: #1a1a1a; }
      .title { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 16px; font-weight: bold; fill: #1a1a1a; }
      .sidebar { fill: #f8f8f8; }
    </style>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="500" class="bg" />
  
  <!-- Window -->
  <rect x="50" y="30" width="700" height="440" class="window" rx="5" />
  
  <!-- Title bar -->
  <rect x="50" y="30" width="700" height="30" class="titlebar" rx="5" />
  <circle cx="70" cy="45" r="6" class="button" />
  <circle cx="90" cy="45" r="6" class="button2" />
  <circle cx="110" cy="45" r="6" class="button3" />
  <text x="400" y="48" class="title" text-anchor="middle">Open Data Modelling</text>
  
  <!-- Sidebar -->
  <rect x="50" y="60" width="180" height="410" class="sidebar" />
  <text x="70" y="90" class="text" font-weight="bold">Contracts</text>
  <text x="70" y="115" class="text">• user-profile</text>
  <text x="70" y="140" class="text">• order-schema</text>
  <text x="70" y="165" class="text">• product-catalog</text>
  
  <!-- Main content -->
  <text x="250" y="90" class="title">user-profile</text>
  <text x="250" y="120" class="text">Version: 1.0.0</text>
  
  <!-- Schema editor -->
  <rect x="250" y="150" width="480" height="300" fill="#ffffff" stroke="#d0d0d0" stroke-width="1" />
  <text x="270" y="180" class="text" font-family="monospace" font-size="12px">{</text>
  <text x="290" y="210" class="text" font-family="monospace" font-size="12px">"id": "string",</text>
  <text x="290" y="240" class="text" font-family="monospace" font-size="12px">"name": "string",</text>
  <text x="290" y="270" class="text" font-family="monospace" font-size="12px">"email": "string"</text>
  <text x="270" y="300" class="text" font-family="monospace" font-size="12px">}</text>
  
  <!-- Validation status -->
  <rect x="250" y="460" width="480" height="30" fill="#e8f5e9" stroke="#4caf50" stroke-width="1" />
  <text x="270" y="480" class="text">✓ Schema is valid</text>
</svg>

