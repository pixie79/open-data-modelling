*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}html{font-size:16px;scroll-behavior:smooth;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}body{font-family:-apple-system,blinkmacsystemfont,segoe ui,roboto,helvetica neue,arial,sans-serif,apple color emoji,segoe ui emoji,segoe ui symbol;font-size:1rem;line-height:1.5;color:#111827;background-color:#fff;min-height:100vh;display:flex;flex-direction:column}h1,h2,h3,h4,h5,h6{font-weight:600;line-height:1.25;margin-bottom:1rem;color:#111827;letter-spacing:-.025em}h1{font-size:2.25rem;font-weight:700;margin-bottom:1.5rem}@media(max-width:768px){h1{font-size:1.875rem}}h2{font-size:1.875rem;margin-top:3rem;margin-bottom:1rem;padding-bottom:.5rem;border-bottom:2px solid #e5e7eb}@media(max-width:768px){h2{font-size:1.5rem}}h3{font-size:1.5rem;margin-top:2rem;margin-bottom:1rem}@media(max-width:768px){h3{font-size:1.25rem}}h4{font-size:1.25rem;margin-top:1.5rem;margin-bottom:.5rem}h5{font-size:1.125rem;margin-top:1rem;margin-bottom:.5rem}h6{font-size:1rem;margin-top:1rem;margin-bottom:.5rem}p{margin-bottom:1rem;line-height:1.75}a{color:#2563eb;text-decoration:none;transition:color 150ms ease-in-out;font-weight:500}a:hover{color:#1e40af;text-decoration:underline}a:focus-visible{outline:2px solid #2563eb;outline-offset:2px;border-radius:.25rem}a:visited{color:#7c3aed}strong,b{font-weight:600}em,i{font-style:italic}code{font-family:sf mono,monaco,cascadia code,roboto mono,consolas,courier new,monospace;font-size:.9em;background-color:#f3f4f6;color:#111827;padding:.125rem .375rem;border-radius:.25rem;border:1px solid #e5e7eb}pre{background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:.5rem;padding:1.5rem;overflow-x:auto;margin-bottom:1.5rem;line-height:1.75}pre code{background:0 0;padding:0;border:none;font-size:.875rem}blockquote{border-left:4px solid #2563eb;padding-left:1.5rem;margin:1.5rem 0;color:#6b7280;font-style:italic}ul,ol{margin-left:2rem;margin-bottom:1rem}ul li,ol li{margin-bottom:.5rem;line-height:1.75}ul{list-style-type:disc}ol{list-style-type:decimal}header{background-color:rgba(255,255,255,.95);border-bottom:1px solid #e5e7eb;position:sticky;top:0;z-index:100;box-shadow:0 1px 2px rgba(0,0,0,5%);backdrop-filter:blur(8px)}.nav-container{max-width:1280px;margin:0 auto;padding:1rem 1.5rem;display:flex;align-items:center;justify-content:space-between;gap:1.5rem}@media(max-width:768px){.nav-container{padding:1rem}}.logo{display:flex;align-items:center;padding:.5rem 0;transition:opacity 150ms ease-in-out}.logo:hover{opacity:.8}.logo:focus-visible{outline:2px solid #2563eb;outline-offset:2px;border-radius:.25rem}.logo img{height:44px;width:auto}.mobile-menu-toggle{display:none;flex-direction:column;background:0 0;border:none;cursor:pointer;padding:.5rem;gap:4px;border-radius:.25rem;transition:background-color 150ms ease-in-out}.mobile-menu-toggle:hover{background-color:#f9fafb}.mobile-menu-toggle:focus-visible{outline:2px solid #2563eb;outline-offset:2px}.mobile-menu-toggle span{width:24px;height:2px;background-color:#111827;border-radius:9999px;transition:all 200ms ease-in-out}@media(max-width:768px){.mobile-menu-toggle{display:flex}}.nav-menu{display:flex;list-style:none;gap:1.5rem;align-items:center;margin:0}@media(max-width:768px){.nav-menu{display:none;position:absolute;top:100%;left:0;right:0;background-color:#fff;flex-direction:column;padding:1.5rem;border-bottom:1px solid #e5e7eb;gap:0;box-shadow:0 10px 15px -3px rgba(0,0,0,.1),0 4px 6px -2px rgba(0,0,0,6%)}.nav-menu.open{display:flex}}.nav-menu li{position:relative}.nav-menu li a{display:block;padding:.5rem 1rem;color:#111827;border-radius:.375rem;transition:background-color 150ms ease-in-out,color 150ms ease-in-out}.nav-menu li a:hover{color:#2563eb;background-color:#f9fafb;text-decoration:none}.nav-menu li a:focus-visible{outline:2px solid #2563eb;outline-offset:2px}.submenu{display:none;position:absolute;top:100%;left:0;background-color:#fff;list-style:none;min-width:220px;box-shadow:0 10px 15px -3px rgba(0,0,0,.1),0 4px 6px -2px rgba(0,0,0,6%);padding:.5rem 0;border-radius:.5rem;border:1px solid #e5e7eb;margin-top:.25rem}@media(max-width:768px){.submenu{position:static;box-shadow:none;padding-left:1.5rem;border:none;margin-top:0}}li:hover>.submenu,li:focus-within>.submenu{display:block}.submenu a{padding:.5rem 1.5rem}#main-content{flex:1;width:100%;padding:0}.hero{background:linear-gradient(135deg,#2563eb 0%,#1e40af 100%);color:#fff;padding:4rem 1.5rem;text-align:center;position:relative;overflow:hidden}.hero::before{content:"";position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");opacity:.3}@media(max-width:768px){.hero{padding:3rem 1rem}}.hero-content{max-width:1280px;margin:0 auto;position:relative;z-index:1}.hero-title{font-size:3.5rem;font-weight:700;margin-bottom:1.5rem;line-height:1.25;letter-spacing:-.02em}@media(max-width:768px){.hero-title{font-size:2.5rem}}@media(max-width:640px){.hero-title{font-size:2rem}}.hero-description{font-size:1.25rem;margin-bottom:3rem;opacity:.95;max-width:700px;margin-left:auto;margin-right:auto;line-height:1.75}@media(max-width:768px){.hero-description{font-size:1.125rem}}.hero-cta{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}.btn{display:inline-block;padding:1rem 2rem;border-radius:.5rem;font-weight:600;font-size:1rem;text-decoration:none;transition:all 200ms ease-in-out;border:2px solid transparent;cursor:pointer}.btn:focus-visible{outline:2px solid #2563eb;outline-offset:2px}.btn-primary{background-color:#fff;color:#2563eb;border-color:#fff}.btn-primary:hover{background-color:#f9fafb;transform:translateY(-2px);box-shadow:0 10px 15px -3px rgba(0,0,0,.1),0 4px 6px -2px rgba(0,0,0,6%);text-decoration:none}.btn-secondary{background-color:initial;color:#fff;border-color:#fff}.btn-secondary:hover{background-color:#fff;color:#2563eb;transform:translateY(-2px);box-shadow:0 10px 15px -3px rgba(0,0,0,.1),0 4px 6px -2px rgba(0,0,0,6%);text-decoration:none}.btn-outline{background-color:initial;color:#2563eb;border-color:#2563eb}.btn-outline:hover{background-color:#2563eb;color:#fff;transform:translateY(-2px);box-shadow:0 10px 15px -3px rgba(0,0,0,.1),0 4px 6px -2px rgba(0,0,0,6%);text-decoration:none}.features{padding:4rem 1.5rem;background-color:#fff}@media(max-width:768px){.features{padding:3rem 1rem}}.features-grid{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:2rem}@media(max-width:768px){.features-grid{grid-template-columns:1fr;gap:1.5rem}}.feature-card{background:#fff;border:1px solid #e5e7eb;border-radius:.75rem;padding:2rem;transition:all 200ms ease-in-out;box-shadow:0 1px 2px rgba(0,0,0,5%)}.feature-card:hover{transform:translateY(-4px);box-shadow:0 10px 15px -3px rgba(0,0,0,.1),0 4px 6px -2px rgba(0,0,0,6%);border-color:#2563eb}.feature-icon{font-size:3rem;margin-bottom:1rem;display:block}.feature-card h2{font-size:1.5rem;margin-bottom:1rem;margin-top:0;border-bottom:none;padding-bottom:0;color:#111827}.feature-card p{color:#6b7280;margin-bottom:1.5rem;line-height:1.75}.feature-link{color:#2563eb;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:.25rem;transition:gap 150ms ease-in-out}.feature-link:hover{color:#1e40af;gap:.5rem;text-decoration:none}.benefits{padding:4rem 1.5rem;background:linear-gradient(to bottom,#f9fafb,#fff)}@media(max-width:768px){.benefits{padding:3rem 1rem}}.section-title{text-align:center;font-size:2.25rem;font-weight:700;margin-bottom:3rem;color:#111827;border-bottom:none;padding-bottom:0;margin-top:0}@media(max-width:768px){.section-title{font-size:1.875rem}}.benefits-grid{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:2rem}@media(max-width:768px){.benefits-grid{grid-template-columns:repeat(2,1fr);gap:1.5rem}}@media(max-width:640px){.benefits-grid{grid-template-columns:1fr}}.benefit-item{text-align:center;padding:1.5rem}.benefit-icon{width:48px;height:48px;background:linear-gradient(135deg,#2563eb,#3b82f6);color:#fff;border-radius:9999px;display:flex;align-items:center;justify-content:center;font-size:1.25rem;font-weight:700;margin:0 auto 1rem;box-shadow:0 4px 6px -1px rgba(0,0,0,.1),0 2px 4px -1px rgba(0,0,0,6%)}.benefit-item h3{font-size:1.25rem;margin-bottom:.5rem;margin-top:0;border-bottom:none;padding-bottom:0;color:#111827}.benefit-item p{color:#6b7280;margin-bottom:0}.products-preview{padding:4rem 1.5rem;background-color:#fff}@media(max-width:768px){.products-preview{padding:3rem 1rem}}.products-grid{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem}@media(max-width:768px){.products-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:640px){.products-grid{grid-template-columns:1fr}}.product-card{background:#f9fafb;border:1px solid #e5e7eb;border-radius:.5rem;padding:1.5rem;transition:all 200ms ease-in-out}.product-card:hover{transform:translateY(-2px);box-shadow:0 4px 6px -1px rgba(0,0,0,.1),0 2px 4px -1px rgba(0,0,0,6%);border-color:#2563eb}.product-card h3{font-size:1.25rem;margin-bottom:.5rem;margin-top:0;border-bottom:none;padding-bottom:0;color:#111827}.product-card p{color:#6b7280;margin-bottom:1rem;font-size:.875rem;line-height:1.75}.product-link{color:#2563eb;font-weight:600;font-size:.875rem;text-decoration:none;display:inline-flex;align-items:center;gap:.25rem;transition:gap 150ms ease-in-out}.product-link:hover{color:#1e40af;gap:.5rem;text-decoration:none}.cta-section{padding:4rem 1.5rem;background:linear-gradient(135deg,#2563eb 0%,#1e40af 100%);color:#fff;text-align:center}@media(max-width:768px){.cta-section{padding:3rem 1rem}}.cta-content{max-width:1280px;margin:0 auto}.cta-section h2{font-size:2.25rem;font-weight:700;margin-bottom:1rem;color:#fff;border-bottom:none;padding-bottom:0;margin-top:0}@media(max-width:768px){.cta-section h2{font-size:1.875rem}}.cta-section p{font-size:1.25rem;margin-bottom:3rem;opacity:.95}@media(max-width:768px){.cta-section p{font-size:1.125rem}}.cta-buttons{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap}article.content,section.content{max-width:1280px;margin:0 auto;padding:3rem 1.5rem;width:100%}@media(max-width:768px){article.content,section.content{padding:2rem 1rem}}article.content>header,section.content>header{margin-bottom:3rem;border-bottom:2px solid #e5e7eb;padding-bottom:1.5rem;position:static;box-shadow:none;backdrop-filter:none;background-color:initial}article.content time,section.content time{color:#6b7280;font-size:.875rem}.content-body{max-width:800px}.content-body img{max-width:100%;height:auto;margin:2rem 0;border-radius:.5rem;box-shadow:0 4px 6px -1px rgba(0,0,0,.1),0 2px 4px -1px rgba(0,0,0,6%)}.content-body figure{margin:2rem 0;text-align:center}.content-body figure img{margin:0}.content-body figure figcaption{margin-top:.5rem;color:#6b7280;font-size:.875rem;font-style:italic}.content .content-body{max-width:800px}.page-list{list-style:none;margin-left:0}.page-list li{margin-bottom:2rem;padding-bottom:1.5rem;border-bottom:1px solid #e5e7eb}.page-list li:last-child{border-bottom:none}.page-list li a{font-size:1.25rem;font-weight:600;display:block;margin-bottom:.5rem}.page-list li p{margin-top:.5rem;color:#6b7280}footer{background-color:#f9fafb;border-top:1px solid #e5e7eb;margin-top:4rem;padding:3rem 1.5rem}.footer-container{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:3rem}.footer-section h2,.footer-section h3{margin-bottom:1rem;font-size:1.125rem;border-bottom:none;margin-top:0;padding-bottom:0}.footer-section p{color:#6b7280;margin-bottom:1rem}.footer-section ul{list-style:none;margin-left:0}.footer-section ul li{margin-bottom:.5rem}.footer-section ul li a{color:#6b7280;font-weight:400}.footer-section ul li a:hover{color:#2563eb}.footer-bottom{max-width:1280px;margin:2rem auto 0;padding-top:1.5rem;border-top:1px solid #e5e7eb;text-align:center;color:#6b7280;font-size:.875rem}.skip-link{position:absolute;top:-40px;left:0;background:#2563eb;color:#fff;padding:.5rem 1rem;text-decoration:none;z-index:1000;border-radius:0 0 .375rem .375rem;font-weight:600}.skip-link:focus{top:0}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border-width:0}@media print{header,footer,.nav-menu,.mobile-menu-toggle{display:none}#main-content{max-width:100%;padding:0}a{text-decoration:underline}pre{border:1px solid #000}}