<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <defs>
    <style>
      .bg { fill: #ffffff; }
      .header { fill: #0066cc; }
      .nav { fill: #f5f5f5; }
      .text { font-family: Arial, sans-serif; font-size: 14px; fill: #1a1a1a; }
      .title { font-family: Arial, sans-serif; font-size: 18px; font-weight: bold; fill: #ffffff; }
      .card { fill: #ffffff; stroke: #e0e0e0; }
    </style>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="500" class="bg" />
  
  <!-- Header -->
  <rect width="800" height="60" class="header" />
  <text x="400" y="40" class="title" text-anchor="middle">Open Data Modelling</text>
  
  <!-- Navigation -->
  <rect width="800" height="40" class="nav" />
  <text x="100" y="90" class="text">Contracts</text>
  <text x="200" y="90" class="text">Schemas</text>
  <text x="300" y="90" class="text">Products</text>
  <text x="400" y="90" class="text">Guides</text>
  
  <!-- Main content -->
  <text x="50" y="140" class="text" font-weight="bold" font-size="20px">My Contracts</text>
  
  <!-- Contract cards -->
  <rect x="50" y="170" width="220" height="120" class="card" rx="5" />
  <text x="70" y="200" class="text" font-weight="bold">user-profile</text>
  <text x="70" y="225" class="text" font-size="12px">Version: 1.0.0</text>
  <text x="70" y="250" class="text" font-size="12px">Last updated: 2 days ago</text>
  <text x="70" y="275" class="text" font-size="12px" fill="#0066cc">Edit →</text>
  
  <rect x="290" y="170" width="220" height="120" class="card" rx="5" />
  <text x="310" y="200" class="text" font-weight="bold">order-schema</text>
  <text x="310" y="225" class="text" font-size="12px">Version: 2.1.0</text>
  <text x="310" y="250" class="text" font-size="12px">Last updated: 1 week ago</text>
  <text x="310" y="275" class="text" font-size="12px" fill="#0066cc">Edit →</text>
  
  <rect x="530" y="170" width="220" height="120" class="card" rx="5" />
  <text x="550" y="200" class="text" font-weight="bold">product-catalog</text>
  <text x="550" y="225" class="text" font-size="12px">Version: 1.5.0</text>
  <text x="550" y="250" class="text" font-size="12px">Last updated: 3 days ago</text>
  <text x="550" y="275" class="text" font-size="12px" fill="#0066cc">Edit →</text>
  
  <!-- Action button -->
  <rect x="50" y="320" width="150" height="40" fill="#0066cc" rx="5" />
  <text x="125" y="345" class="text" fill="#ffffff" text-anchor="middle" font-weight="bold">+ New Contract</text>
  
  <!-- Schema editor preview -->
  <rect x="50" y="380" width="700" height="100" class="card" rx="5" />
  <text x="70" y="410" class="text" font-weight="bold">Schema Editor</text>
  <text x="70" y="440" class="text" font-family="monospace" font-size="12px">{ "type": "object", "properties": { ... } }</text>
</svg>

