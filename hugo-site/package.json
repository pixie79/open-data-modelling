{
  "name": "opendatamodelling-docs",
  "version": "1.0.0",
  "description": "Open Data Modelling documentation website",
  "scripts": {
    "format": "prettier --write \"**/*.{md,json,yaml,yml,js,ts,css,scss,html}\"",
    "lint:markdown": "markdownlint-cli2 --config .markdownlint.json \"**/*.md\" \"!node_modules/**\" \"!public/**\" \"!themes/**\"",
    "lint:css": "stylelint \"assets/**/*.{css,scss}\"",
    "lint:js": "eslint \"assets/**/*.{js,ts}\" || true",
    "lint:html": "htmlhint \"public/**/*.html\" || true",
    "lint": "npm run lint:markdown && npm run lint:css && npm run lint:js",
    "test:links": "which htmltest > /dev/null && htmltest public/ || echo 'htmltest not installed, skipping link check'",
    "test:accessibility": "axe-core public/ || true",
    "build": "hugo --minify",
    "serve": "hugo server --buildDrafts",
    "clean": "rm -rf public"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.8.0",
    "eslint": "^8.57.0",
    "htmlhint": "^1.1.4",
    "markdownlint-cli2": "^0.11.0",
    "prettier": "^3.2.5",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^13.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
